# Firebase Configuration
PROJECT_ID=your-firebase-project-id

# LOCAL_DEV: set to "1" for local FastAPI server ONLY.
# WARNING: do NOT set this in production (.env deployed to Cloud Functions).
# It activates a local App Check middleware that assumes firebase_app_check
# is initialised via the FastAPI lifespan — which never runs in the Cloud
# Function ASGI bridge, causing every request to return 500.
# LOCAL_DEV=1

# Optional: Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
