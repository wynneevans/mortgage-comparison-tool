# API Configuration
VITE_API_URL=/api

# Firebase Configuration
# Get these values from Firebase Console > Project Settings > Your apps
VITE_FIREBASE_API_KEY=your-api-key-here
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# reCAPTCHA Enterprise Site Key
# Get this from Google Cloud Console > reCAPTCHA Enterprise
VITE_RECAPTCHA_SITE_KEY=your-recaptcha-site-key

# Optional: Debug token for local development
# Generate this in Firebase Console > App Check > Debug tokens
# VITE_APPCHECK_DEBUG_TOKEN=your-debug-token-uuid
